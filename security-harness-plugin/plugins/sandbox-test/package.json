{
  "name": "@security-harness/sandbox-test",
  "version": "0.1.0",
  "description": "Visible and bounded workspace boundary demo for DeepSeek Harness sandbox modes",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "prepare": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-sandbox": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-shell": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.0-rc.7",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3"
  }
}
